#!/usr/bin/env node

const base = new URL(
  process.argv.find((argument) => argument.startsWith('--url='))
    ?.slice('--url='.length) ?? process.env.SITE_URL ?? 'http://127.0.0.1:4321',
);
const origin = base.origin;
const queue = [new URL(base)];
const seen = new Set();
const failures = [];
const checked = [];

function sameOrigin(url) {
  return url.origin === origin;
}

function collectReferences(html, pageUrl) {
  const references = [];
  const attributes = /<(?:a|area|link|img|script|source|video|audio|iframe|object)\b[^>]+?(?:href|src|data)=["']([^"']+)["']/gi;
  for (const match of html.matchAll(attributes)) {
    try {
      const url = new URL(match[1], pageUrl);
      if (url.pathname.includes('%2f') || url.pathname.includes('%2F')) {
        failures.push(`Encoded %2F link ${url.pathname} in ${pageUrl.pathname}`);
      }
      if (sameOrigin(url) && !['mailto:', 'tel:', 'javascript:'].includes(url.protocol)) {
        url.hash = '';
        references.push(url);
      }
    } catch {
      failures.push(`Invalid reference ${match[1]} in ${pageUrl.pathname}`);
    }
  }
  return references;
}

async function check(url) {
  if (seen.has(url.href)) return;
  seen.add(url.href);
  const response = await fetch(url, { redirect: 'manual' });
  checked.push(`${response.status} ${url.pathname || '/'}`);
  if (response.status !== 200) {
    failures.push(`${url.href} returned ${response.status}`);
    return;
  }
  const contentType = response.headers.get('content-type') ?? '';
  const body = contentType.includes('text/html') || contentType.includes('json') ? await response.text() : '';
  if (/purchase_price/i.test(body)) failures.push(`purchase_price leaked in ${url.pathname}`);
  if (/\b(coming soon|lorem ipsum|TODO|replace_with|placeholder text)\b/i.test(body)) {
    failures.push(`Placeholder text found in ${url.pathname}`);
  }
  if (contentType.includes('text/html')) {
    const html = body;
    if (url.pathname === base.pathname || url.pathname === '/') {
      const robots = response.headers.get('x-robots-tag') ?? '';
      if (!/index/i.test(robots)) {
        failures.push('Home page is missing the X-Robots-Tag index header');
      }
      if (!html.includes('7264 HWY 411, Benton, TN 37307')) {
        failures.push('Home page is missing the Smoky Motors address');
      }
    }
    queue.push(...collectReferences(html, url));
  }
}

try {
  while (queue.length) await check(queue.shift());
  const robotsUrl = new URL('/robots.txt', base);
  const robotsResponse = await fetch(robotsUrl, { redirect: 'manual' });
  checked.push(`${robotsResponse.status} /robots.txt`);
  const robotsText = await robotsResponse.text();
  if (robotsResponse.status !== 200 || !/Allow:\s*\/\s*(?:\r?\n|$)/i.test(robotsText)) {
    failures.push('robots.txt must return 200 and allow the public site');
  }
  const inventoryUrl = new URL('/inventory', base);
  const inventoryResponse = await fetch(inventoryUrl);
  const inventoryHtml = await inventoryResponse.text();
  if (inventoryResponse.status !== 200 || !/vehicle-card|vehicle-placeholder/i.test(inventoryHtml)) {
    failures.push('Inventory is empty or unavailable');
  }
  const apiResponse = await fetch(new URL('/api/vehicles.json', base));
  const apiText = await apiResponse.text();
  if (apiResponse.status !== 200 || !Array.isArray(JSON.parse(apiText)) || JSON.parse(apiText).length === 0) {
    failures.push('Public inventory API is empty or unavailable');
  }
  if (/purchase_price/i.test(apiText)) failures.push('purchase_price leaked in the public inventory API');
  for (const match of inventoryHtml.matchAll(/href=["'](\/inventory\/[^"']+)["']/gi)) {
    const vehicleUrl = new URL(match[1], base);
    const vehicleResponse = await fetch(vehicleUrl);
    const vehicleHtml = await vehicleResponse.text();
    checked.push(`${vehicleResponse.status} ${vehicleUrl.pathname}`);
    for (const required of ['price', 'mileage', 'VIN', 'Sold as-is, no warranty']) {
      if (!new RegExp(required, 'i').test(vehicleHtml)) failures.push(`${vehicleUrl.pathname} is missing ${required}`);
    }
    if (/purchase_price/i.test(vehicleHtml)) failures.push(`purchase_price leaked in ${vehicleUrl.pathname}`);
  }
} catch (error) {
  failures.push(error instanceof Error ? error.message : String(error));
}

console.log(`verify-site ${base.href}`);
console.log(`Checked ${checked.length} URLs`);
console.log(checked.map((line) => `  ${line}`).join('\n'));
if (failures.length) {
  console.error(`FAILED (${failures.length})`);
  console.error(failures.map((failure) => `  - ${failure}`).join('\n'));
  process.exit(1);
}
console.log('PASS: all links/assets returned 200; inventory, vehicle fields, and purchase_price privacy verified.');
