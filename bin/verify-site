#!/usr/bin/env node

const base = new URL(
  process.argv.find((argument) => argument.startsWith('--url='))
    ?.slice('--url='.length) ?? process.env.SITE_URL ?? 'http://127.0.0.1:4321',
);
const origin = base.origin;
const queue = [new URL(base)];
const seen = new Set();
const failures = [];
const checked = [];

function sameOrigin(url) {
  return url.origin === origin;
}

function collectReferences(html, pageUrl) {
  const references = [];
  const attributes = /<(?:a|area|link|img|script|source|video|audio|iframe|object)\b[^>]+?(?:href|src|data)=["']([^"']+)["']/gi;
  for (const match of html.matchAll(attributes)) {
    try {
      const url = new URL(match[1], pageUrl);
      if (sameOrigin(url) && !['mailto:', 'tel:', 'javascript:'].includes(url.protocol)) {
        url.hash = '';
        references.push(url);
      }
    } catch {
      failures.push(`Invalid reference ${match[1]} in ${pageUrl.pathname}`);
    }
  }
  return references;
}

async function check(url) {
  if (seen.has(url.href)) return;
  seen.add(url.href);
  const response = await fetch(url, { redirect: 'manual' });
  checked.push(`${response.status} ${url.pathname || '/'}`);
  if (response.status !== 200) {
    failures.push(`${url.href} returned ${response.status}`);
    return;
  }
  const contentType = response.headers.get('content-type') ?? '';
  if (contentType.includes('text/html')) {
    const html = await response.text();
    if (url.pathname === base.pathname || url.pathname === '/') {
      if (!/<meta[^>]+name=["']robots["'][^>]+content=["'][^"']*noindex[^"']*nofollow/i.test(html)) {
        failures.push('Home page is missing the noindex,nofollow robots meta tag');
      }
      const robots = response.headers.get('x-robots-tag') ?? '';
      if (!/noindex/i.test(robots)) {
        failures.push('Home page is missing the X-Robots-Tag noindex header');
      }
      if (!html.includes('7264 HWY 411, Benton, TN 37307')) {
        failures.push('Home page is missing the Smoky Motors address');
      }
    }
    queue.push(...collectReferences(html, url));
  }
}

try {
  while (queue.length) await check(queue.shift());
  const robotsUrl = new URL('/robots.txt', base);
  const robotsResponse = await fetch(robotsUrl, { redirect: 'manual' });
  checked.push(`${robotsResponse.status} /robots.txt`);
  const robotsText = await robotsResponse.text();
  if (robotsResponse.status !== 200 || !/Disallow:\s*\/\s*(?:\r?\n|$)/i.test(robotsText)) {
    failures.push('robots.txt must return 200 and disallow all crawlers');
  }
} catch (error) {
  failures.push(error instanceof Error ? error.message : String(error));
}

console.log(`verify-site ${base.href}`);
console.log(`Checked ${checked.length} URLs`);
console.log(checked.map((line) => `  ${line}`).join('\n'));
if (failures.length) {
  console.error(`FAILED (${failures.length})`);
  console.error(failures.map((failure) => `  - ${failure}`).join('\n'));
  process.exit(1);
}
console.log('PASS: all links/assets returned 200; address and noindex safeguards verified.');
