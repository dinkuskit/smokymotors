---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="About">
  <section class="page"><p class="eyebrow">About Smoky Motors</p><h1>Good cars.<br /><em>Good people.</em></h1><p>Smoky Motors is a local used-vehicle lot in Benton, Tennessee. We keep the process simple: see the vehicle, ask direct questions, and make the decision that works for you.</p><p>No online payments or checkout. Just a real lot, real vehicles, and a team ready to help.</p><a class="button" href="/contact">Come see us →</a></section>
</SiteLayout>
<style>.page{max-width:720px;padding:7rem 0}.eyebrow{color:var(--green);font:500 .7rem 'DM Mono',monospace;letter-spacing:.12em;text-transform:uppercase}.page h1{font-size:clamp(3.5rem,9vw,8rem);letter-spacing:-.1em;line-height:.88;margin:1rem 0 2rem}.page h1 em{color:var(--green);font-style:normal}.page p:not(.eyebrow){color:var(--muted);font-size:1.1rem;line-height:1.7}.button{display:inline-block;margin-top:1.5rem;padding:1rem 1.2rem;background:var(--green);color:#0b0f0d;font-weight:800;text-decoration:none}</style>
