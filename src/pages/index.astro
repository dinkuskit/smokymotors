---
import { getEmDashEntry } from 'emdash';

const { entry: home } = await getEmDashEntry('pages', 'home');
const content = home?.data as {
  title?: string;
  headline?: string;
  status_line?: string;
  address?: string;
} | undefined;
const title = content?.title ?? 'Smoky Motors';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="Smoky Motors is coming soon to Benton, Tennessee." />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main class="landing">
      <div class="atmosphere atmosphere-one" aria-hidden="true"></div>
      <div class="atmosphere atmosphere-two" aria-hidden="true"></div>
      <div class="road-glow" aria-hidden="true"></div>

      <section class="hero" aria-labelledby="brand">
        <p class="eyebrow">Benton, Tennessee</p>
        <h1 id="brand">
          {content?.headline ?? 'SMOKY MOTORS'}
        </h1>
        <p class="status">{content?.status_line ?? 'Coming soon'}</p>
        <address>{content?.address ?? '7264 HWY 411, Benton, TN 37307'}</address>
      </section>
    </main>
  </body>
</html>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;600;700;800&display=swap');

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    background: #090b0d;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    color: #f3f4ef;
    background: #090b0d;
    font-family: 'Manrope', system-ui, sans-serif;
  }

  .landing {
    isolation: isolate;
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow: hidden;
    place-items: center;
    background:
      radial-gradient(circle at 50% 46%, rgba(69, 79, 73, 0.25), transparent 38%),
      linear-gradient(145deg, #0b0e0f 0%, #151a18 54%, #080a0b 100%);
  }

  .landing::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.23;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 5rem 5rem;
    content: '';
    mask-image: linear-gradient(to bottom, transparent, black 35%, transparent 95%);
  }

  .hero {
    position: relative;
    z-index: 2;
    width: min(90vw, 70rem);
    padding: 3rem 0;
    text-align: center;
    animation: reveal 1.1s cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }

  .eyebrow,
  .status,
  address {
    color: #b8c7b6;
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.7rem, 1.3vw, 0.85rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 clamp(1.2rem, 3vw, 2.3rem);
    animation: lift-in 0.8s 0.1s both;
  }

  h1 {
    margin: 0;
    color: #f4f5ee;
    font-size: clamp(4.1rem, 15vw, 12.5rem);
    font-weight: 800;
    letter-spacing: -0.095em;
    line-height: 0.76;
    text-transform: uppercase;
    text-shadow:
      0 0 1.5rem rgba(185, 230, 179, 0.1),
      0 0.08em 0 #121714;
    transform: perspective(800px) rotateX(8deg);
  }

  h1 span {
    display: block;
  }

  h1 span:last-child {
    margin-left: 0.22em;
    color: #c8e6bc;
  }

  .status {
    margin: clamp(2rem, 5vw, 3.75rem) 0 1rem;
    color: #d9f2c9;
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    font-weight: 500;
    animation: lift-in 0.8s 0.32s both;
  }

  address {
    margin: 0;
    color: #9ba69c;
    font-style: normal;
    font-size: clamp(0.62rem, 1.2vw, 0.75rem);
    letter-spacing: 0.11em;
    animation: lift-in 0.8s 0.44s both;
  }

  .atmosphere,
  .road-glow {
    position: absolute;
    pointer-events: none;
  }

  .atmosphere {
    z-index: -1;
    width: clamp(16rem, 45vw, 40rem);
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(4rem);
    opacity: 0.22;
  }

  .atmosphere-one {
    top: -22%;
    left: -15%;
    background: #365a45;
    animation: drift-one 16s ease-in-out infinite alternate;
  }

  .atmosphere-two {
    right: -15%;
    bottom: -28%;
    background: #8b5b32;
    animation: drift-two 20s ease-in-out infinite alternate;
  }

  .road-glow {
    bottom: -36%;
    left: 50%;
    width: 150%;
    height: 70%;
    border-top: 1px solid rgba(215, 242, 201, 0.17);
    border-radius: 50% 50% 0 0;
    box-shadow:
      0 -2rem 5rem rgba(161, 204, 151, 0.07),
      0 -0.2rem 0.4rem rgba(239, 200, 130, 0.12);
    transform: translateX(-50%) rotate(-4deg);
  }

  @keyframes reveal {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes lift-in {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes drift-one {
    to { transform: translate(10%, 14%) scale(1.12); }
  }

  @keyframes drift-two {
    to { transform: translate(-12%, -10%) scale(1.18); }
  }

  @media (max-width: 520px) {
    .hero {
      width: min(88vw, 28rem);
    }

    h1 {
      font-size: clamp(3.5rem, 18vw, 6rem);
      line-height: 0.82;
    }

    address {
      letter-spacing: 0.07em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
