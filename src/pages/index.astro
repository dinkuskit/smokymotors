---
import SiteLayout from '../layouts/SiteLayout.astro';
import { siteConfig } from '../config';
import { getHomePage, getPublicVehicles } from '../data';

const content = await getHomePage();
const vehicles = (await getPublicVehicles()).slice(0, 3);
---

<SiteLayout title={content?.title ?? siteConfig.name}>
  <section class="hero">
    <p class="eyebrow">Benton, Tennessee · Established for the road ahead</p>
    <h1>{content?.headline ?? 'Find your next ride.'}</h1>
    <p class="lede">Straightforward used vehicles, hand-selected for East Tennessee. No pressure. No payments or checkout online.</p>
    <div class="actions"><a class="button" href="/inventory">Browse inventory</a><a class="text-link" href="/contact">Visit the lot →</a></div>
  </section>
  <section class="feature"><div><p class="eyebrow">Fresh on the lot</p><h2>Ready when you are.</h2></div><a class="text-link" href="/inventory">View all inventory →</a></section>
  <div class="vehicle-grid">
    {vehicles.map((vehicle) => <a class="vehicle-card" href={`/inventory/${vehicle.slug}`}><img src="/vehicle-placeholder.svg" alt="" /><div><span>{vehicle.year} {vehicle.make}</span><h3>{vehicle.model} {vehicle.trim}</h3><strong>${vehicle.price.toLocaleString()}</strong></div></a>)}
  </div>
</SiteLayout>

<style>
  .hero { padding:clamp(5rem,12vw,10rem) 0 8rem; max-width:800px; }
  .eyebrow { color:var(--green); font:500 .72rem 'DM Mono',monospace; letter-spacing:.12em; text-transform:uppercase; }
  h1 { max-width:760px; margin:1.2rem 0; font-size:clamp(3.6rem,10vw,8.5rem); letter-spacing:-.09em; line-height:.88; }
  .lede { max-width:540px; color:var(--muted); font-size:1.1rem; line-height:1.6; }
  .actions { display:flex; align-items:center; gap:1.5rem; margin-top:2.5rem; }
  .button { padding:1rem 1.2rem; color:#0b0f0d; background:var(--green); font-weight:800; text-decoration:none; }
  .text-link { color:var(--green); font-weight:700; text-decoration:none; }
  .feature { display:flex; justify-content:space-between; align-items:end; border-top:1px solid var(--line); padding:2.2rem 0 1.5rem; }
  h2 { margin:.4rem 0; font-size:clamp(2rem,5vw,4rem); letter-spacing:-.07em; }
  .vehicle-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
  .vehicle-card { background:var(--card); text-decoration:none; }
  .vehicle-card img { display:block; width:100%; aspect-ratio:1.5; object-fit:cover; }
  .vehicle-card div { padding:1rem; }
  .vehicle-card span { color:var(--muted); font: .68rem 'DM Mono',monospace; text-transform:uppercase; }
  h3 { margin:.5rem 0 1.2rem; font-size:1.2rem; }
  .vehicle-card strong { color:var(--green); }
  @media (max-width:700px) { .vehicle-grid { grid-template-columns:1fr; } .feature { align-items:flex-start; flex-direction:column; gap:1rem; } }
</style>
