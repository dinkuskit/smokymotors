{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smokymotors",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smokymotors",
      "database_id": "REPLACE_WITH_SMOKYMOTORS_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "smokymotors-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
