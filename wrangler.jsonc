{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smokymotors",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smokymotors",
      "database_id": "69a9fe47-eb65-4fce-9f17-9968476ec5bb"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "977edb787e954c008db988ad23df89f6"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "smokymotors-media"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "routes": [
    {
      "pattern": "smokymotors.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
